# VarshaMitra Frontend Environment Configuration
# Set the FastAPI backend base URL
NEXT_PUBLIC_API_BASE_URL="http://127.0.0.1:8000"

# Optional Custom Map Tile URL (defaults to free, keyless OpenStreetMap standard raster tiles)
# Example custom CARTO voyager with API key:
# NEXT_PUBLIC_MAP_TILE_URL="https://a.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}@2x.png?api_key=YOUR_CARTO_KEY"
